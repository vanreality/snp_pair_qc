params {
    input_samplesheet         = null
    methylation_mode          = false
    fasta                     = null
    fasta_index               = null
    bwa_index_dir             = null
    known_sites_tsv           = null
    outdir                    = null
    trace_report_suffix       = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')// Config options
}

process {
    executor = 'slurm'

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'TRIMGALORE' {
        container = "${baseDir}/containers/trim-galore_0.6.10.sif"
        cpus      = 16
        memory    = 32.GB
        time      = 24.h
        queue     = 'cn-long'
    }

    withName: 'BWAMETH_INDEX' {
        container = "${baseDir}/containers/bwameth_0.2.9.sif"
        cpus      = 16
        memory    = 32.GB
        time      = 24.h
        queue     = 'cn-long'
    }

    withName: 'BWAMETH_ALIGN' {
        container = "${baseDir}/containers/bwameth_0.2.9.sif"
        cpus      = 8
        memory    = 64.GB
        time      = 24.h
        queue     = 'cn-long'
        ext.args  = ''
        ext.args2 = ''
    }

    withName: 'BWAMEM2_INDEX' {
        container = "${baseDir}/containers/bwa-mem2_htslib_samtools.sif"
        cpus      = 16
        memory    = 32.GB
        time      = 24.h
        queue     = 'cn-long'
    }

    withName: 'BWAMEM2_MEM' {
        container = "${baseDir}/containers/bwa-mem2_htslib_samtools.sif"
        cpus      = 16
        memory    = 32.GB
        time      = 24.h
        queue     = 'cn-long'
        ext.args  = "-R '@RG\\tID:1\\tSM:1\\tLB:lib1\\tPL:ILLUMINA'"
    }

    withName: 'PICARD_MARKDUPLICATES' {
        container = "${baseDir}/containers/picard_3.4.0.sif"
        cpus      = 8
        memory    = 16.GB
        time      = 24.h
        queue     = 'cn-long'
        ext.suffix= 'dedup.bam'
        ext.args  = '--REMOVE_DUPLICATES true --CREATE_INDEX true --READ_NAME_REGEX null'
        publishDir = [ enabled: false ]
    }

    withName: 'SNP_PILEUP' {
        container = "${baseDir}/containers/common_tools.sif"
        cpus      = 8
        memory    = 16.GB
        time      = 24.h
        queue     = 'cn-long'
    }

    withName: 'SNP_CORRELATION' {
        container = "${baseDir}/containers/common_tools.sif"
        cpus      = 8
        memory    = 16.GB
        time      = 24.h
        queue     = 'cn-long'
    }

    withName: 'SAMTOOLS_SORT' {
        container = "${baseDir}/containers/common_tools.sif"
        cpus      = 16
        memory    = 32.GB
        time      = 24.h
        queue     = 'cn-long'
        ext.prefix  = 'sorted'
    }

    withName: 'SNP_CORRELATION_HEATMAP' {
        container = "${baseDir}/containers/common_tools.sif"
        cpus      = 8
        memory    = 16.GB
        time      = 24.h
        queue     = 'cn-long'
    }
}

profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "-B /lustre1,/lustre2,/appsnew"
    }
}

manifest {
    author = 'vanreality'
    name = 'snp_pair_qc'
    description = 'A pipeline for SNP pair quality control'
    version = 'dev1.0'
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}